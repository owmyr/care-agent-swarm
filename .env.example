# Anthropic API key (only required when DEMO_MODE=false)
ANTHROPIC_API_KEY=

# DEMO_MODE=true (default) uses FakeAnthropicClient — deterministic, no API key needed.
# DEMO_MODE=false requires ANTHROPIC_API_KEY above.
DEMO_MODE=true

# Default model for the harness
ANTHROPIC_MODEL=claude-sonnet-4-5

# Harness defaults
HARNESS_MAX_ATTEMPTS=3
HARNESS_TIMEOUT_MS=20000
HARNESS_BASE_BACKOFF_MS=500
HARNESS_MAX_BACKOFF_MS=30000
HARNESS_JITTER_MS=1000

# Set to true to opt in to logging full prompt/output content (default false: metadata-only).
# Use only for debugging — logs will include redacted prompt/output payloads.
HARNESS_LOG_CONTENT=false

# Circuit breaker defaults
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# Logging
LOG_LEVEL=info
